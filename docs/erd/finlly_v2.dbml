// Finlly v2 — ERD (DBML)
// Editável em: https://dbdiagram.io
// Gerado em: 2026-02-27
// Modelo Postgres — UUID para entidades principais, BIGSERIAL para logs/jobs

//
// ─── ENUMS ────────────────────────────────────────────────────────────────────
//

Enum status_assinante {
  trial
  ativo
  inativo
  cancelado
  inadimplente
}

Enum status_pagamento {
  pendente
  pago
  cancelado
  estornado
  falhou
}

Enum status_conta {
  ativa
  inativa
  arquivada
}

Enum status_meta {
  ativa
  concluida
  cancelada
}

Enum tipo_conta {
  corrente
  poupanca
  cartao_credito
  cartao_debito
  dinheiro
  investimento
  outro
}

Enum tipo_movimentacao {
  entrada
  saida
  transferencia
}

Enum tipo_meta {
  economia
  despesa
  investimento
}

Enum tipo_evento_investimento {
  aporte
  resgate
  rendimento
  taxa
  dividendo
}

Enum tipo_recorrencia {
  diario
  semanal
  quinzenal
  mensal
  bimestral
  trimestral
  semestral
  anual
}

//
// ─── DOMAIN: USUÁRIOS ─────────────────────────────────────────────────────────
//

Table usuarios {
  id              uuid        [pk, default: `gen_random_uuid()`]
  nome            varchar(255) [not null]
  email           varchar(255) [not null, unique]
  senha_hash      varchar(255) [not null]
  telefone        varchar(20)
  avatar_url      text
  email_verificado boolean     [not null, default: false]
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]
  deleted_at      timestamptz

  Note: 'Entidade principal de usuário. Soft-delete via deleted_at (LGPD).'
}

//
// ─── DOMAIN: BILLING ──────────────────────────────────────────────────────────
//

Table cupons {
  id                  uuid        [pk, default: `gen_random_uuid()`]
  codigo              varchar(50) [not null, unique]
  desconto_percentual decimal(5,2)
  desconto_fixo       decimal(10,2)
  valido_ate          timestamptz
  uso_maximo          integer
  uso_atual           integer     [not null, default: 0]
  ativo               boolean     [not null, default: true]
  created_at          timestamptz [not null, default: `now()`]
  updated_at          timestamptz [not null, default: `now()`]
  deleted_at          timestamptz

  Note: 'Cupons de desconto para assinatura. Soft-delete.'
}

Table assinantes {
  id                       uuid              [pk, default: `gen_random_uuid()`]
  usuario_id               uuid              [not null, ref: > usuarios.id]
  status                   status_assinante  [not null, default: 'trial']
  plano                    varchar(50)       [not null, default: 'free']
  provider                 varchar(50)
  provider_customer_id     varchar(100)
  provider_subscription_id varchar(100)
  cupom_id                 uuid              [ref: > cupons.id]
  trial_inicio             timestamptz
  trial_fim                timestamptz
  proxima_cobranca         timestamptz
  created_at               timestamptz       [not null, default: `now()`]
  updated_at               timestamptz       [not null, default: `now()`]
  deleted_at               timestamptz

  Note: 'Um registro por usuário. Soft-delete. provider = asaas | stripe | manual.'
}

Table assinantes_pagamentos {
  id                uuid            [pk, default: `gen_random_uuid()`]
  assinante_id      uuid            [not null, ref: > assinantes.id]
  usuario_id        uuid            [not null, ref: > usuarios.id]
  status            status_pagamento [not null, default: 'pendente']
  valor             decimal(10,2)   [not null]
  provider          varchar(50)
  provider_payment_id varchar(100)
  descricao         text
  data_pagamento    timestamptz
  data_vencimento   timestamptz
  created_at        timestamptz     [not null, default: `now()`]
  updated_at        timestamptz     [not null, default: `now()`]
  deleted_at        timestamptz

  Note: 'Histórico de cobranças por assinante. Soft-delete.'
}

Table webhook_events {
  id            bigserial   [pk]
  provider      varchar(50) [not null]
  event_id      varchar(255) [not null]
  event_type    varchar(100) [not null]
  payload       jsonb       [not null]
  processado    boolean     [not null, default: false]
  processado_em timestamptz
  erro          text
  created_at    timestamptz [not null, default: `now()`]

  indexes {
    (provider, event_id) [unique, name: 'uq_webhook_provider_event']
    processado           [name: 'idx_webhook_processado']
  }

  Note: 'BIGSERIAL — alto throughput. Hard-delete. Sem deleted_at.'
}

//
// ─── DOMAIN: FINANCEIRO ───────────────────────────────────────────────────────
//

Table instituicoes_financeiras {
  id                  uuid        [pk, default: `gen_random_uuid()`]
  nome                varchar(255) [not null, unique]
  codigo_compensacao  varchar(10)
  logo_url            text
  created_at          timestamptz [not null, default: `now()`]
  updated_at          timestamptz [not null, default: `now()`]
  deleted_at          timestamptz

  Note: 'Lookup table para bancos/instituições. Soft-delete.'
}

Table contas {
  id                      uuid         [pk, default: `gen_random_uuid()`]
  usuario_id              uuid         [not null, ref: > usuarios.id]
  nome                    varchar(255) [not null]
  tipo                    tipo_conta   [not null]
  instituicao_financeira_id uuid       [ref: > instituicoes_financeiras.id]
  cor                     varchar(7)
  icone                   varchar(50)
  incluir_total           boolean      [not null, default: true]
  status                  status_conta [not null, default: 'ativa']
  created_at              timestamptz  [not null, default: `now()`]
  updated_at              timestamptz  [not null, default: `now()`]
  deleted_at              timestamptz

  indexes {
    (usuario_id, status) [name: 'idx_contas_usuario_status']
  }

  Note: 'Saldo não armazenado — calculado via movimentacoes_caixa. Soft-delete.'
}

Table categorias {
  id          uuid             [pk, default: `gen_random_uuid()`]
  usuario_id  uuid             [ref: > usuarios.id]
  nome        varchar(255)     [not null]
  tipo        tipo_movimentacao [not null]
  icone       varchar(50)
  cor         varchar(7)
  pai_id      uuid             [ref: > categorias.id]
  is_sistema  boolean          [not null, default: false]
  created_at  timestamptz      [not null, default: `now()`]
  updated_at  timestamptz      [not null, default: `now()`]
  deleted_at  timestamptz

  indexes {
    (usuario_id, tipo) [name: 'idx_categorias_usuario_tipo']
  }

  Note: 'usuario_id NULL = categoria do sistema. Hierarquia via pai_id. Soft-delete.'
}

Table contas_pagar {
  id                   uuid             [pk, default: `gen_random_uuid()`]
  usuario_id           uuid             [not null, ref: > usuarios.id]
  descricao            varchar(500)     [not null]
  valor                decimal(10,2)    [not null]
  data_vencimento      date             [not null]
  data_pagamento       date
  status               status_pagamento [not null, default: 'pendente']
  categoria_id         uuid             [ref: > categorias.id]
  conta_id             uuid             [ref: > contas.id]
  recorrente           boolean          [not null, default: false]
  recorrencia          tipo_recorrencia
  parcela_atual        integer
  total_parcelas       integer
  grupo_recorrencia_id uuid
  observacoes          text
  created_at           timestamptz      [not null, default: `now()`]
  updated_at           timestamptz      [not null, default: `now()`]
  deleted_at           timestamptz

  indexes {
    (usuario_id, data_vencimento)     [name: 'idx_cpagar_usuario_vencimento']
    (usuario_id, status)              [name: 'idx_cpagar_usuario_status']
    grupo_recorrencia_id              [name: 'idx_cpagar_grupo_recorrencia']
  }

  Note: 'Contas a pagar com suporte a recorrência e parcelamento. Soft-delete.'
}

Table contas_receber {
  id                   uuid             [pk, default: `gen_random_uuid()`]
  usuario_id           uuid             [not null, ref: > usuarios.id]
  descricao            varchar(500)     [not null]
  valor                decimal(10,2)    [not null]
  data_vencimento      date             [not null]
  data_recebimento     date
  status               status_pagamento [not null, default: 'pendente']
  categoria_id         uuid             [ref: > categorias.id]
  conta_id             uuid             [ref: > contas.id]
  recorrente           boolean          [not null, default: false]
  recorrencia          tipo_recorrencia
  parcela_atual        integer
  total_parcelas       integer
  grupo_recorrencia_id uuid
  observacoes          text
  created_at           timestamptz      [not null, default: `now()`]
  updated_at           timestamptz      [not null, default: `now()`]
  deleted_at           timestamptz

  indexes {
    (usuario_id, data_vencimento)     [name: 'idx_creceber_usuario_vencimento']
    (usuario_id, status)              [name: 'idx_creceber_usuario_status']
    grupo_recorrencia_id              [name: 'idx_creceber_grupo_recorrencia']
  }

  Note: 'Contas a receber com suporte a recorrência e parcelamento. Soft-delete.'
}

Table movimentacoes_caixa {
  id               uuid             [pk, default: `gen_random_uuid()`]
  usuario_id       uuid             [not null, ref: > usuarios.id]
  conta_id         uuid             [not null, ref: > contas.id]
  tipo             tipo_movimentacao [not null]
  valor            decimal(10,2)    [not null]
  descricao        varchar(500)     [not null]
  data             date             [not null]
  categoria_id     uuid             [ref: > categorias.id]
  conta_destino_id uuid             [ref: > contas.id]
  conta_pagar_id   uuid             [ref: > contas_pagar.id]
  conta_receber_id uuid             [ref: > contas_receber.id]
  observacoes      text
  created_at       timestamptz      [not null, default: `now()`]
  updated_at       timestamptz      [not null, default: `now()`]
  deleted_at       timestamptz

  indexes {
    (usuario_id, data)           [name: 'idx_movimentacoes_usuario_data']
    (usuario_id, tipo)           [name: 'idx_movimentacoes_usuario_tipo']
    (conta_id, data)             [name: 'idx_movimentacoes_conta_data']
  }

  Note: 'Fonte de verdade do saldo. Soft-delete. transferencia usa conta_destino_id.'
}

//
// ─── DOMAIN: INVESTIMENTOS ────────────────────────────────────────────────────
//

Table tipos_investimento {
  id          uuid        [pk, default: `gen_random_uuid()`]
  nome        varchar(100) [not null, unique]
  descricao   text
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]
  deleted_at  timestamptz

  Note: 'Lookup table: CDB, LCI, Tesouro Direto, Ações, FII, etc.'
}

Table investimentos {
  id             uuid         [pk, default: `gen_random_uuid()`]
  usuario_id     uuid         [not null, ref: > usuarios.id]
  nome           varchar(255) [not null]
  tipo_id        uuid         [not null, ref: > tipos_investimento.id]
  instituicao_id uuid         [ref: > instituicoes_financeiras.id]
  valor_inicial  decimal(10,2) [not null, default: 0]
  data_inicio    date         [not null]
  data_vencimento date
  status         status_conta [not null, default: 'ativa']
  observacoes    text
  created_at     timestamptz  [not null, default: `now()`]
  updated_at     timestamptz  [not null, default: `now()`]
  deleted_at     timestamptz

  indexes {
    (usuario_id, status) [name: 'idx_investimentos_usuario_status']
    (usuario_id, tipo_id) [name: 'idx_investimentos_usuario_tipo']
  }

  Note: 'Valor atual calculado via investimentos_eventos. Soft-delete.'
}

Table investimentos_eventos {
  id             uuid                   [pk, default: `gen_random_uuid()`]
  investimento_id uuid                  [not null, ref: > investimentos.id]
  usuario_id     uuid                   [not null, ref: > usuarios.id]
  tipo           tipo_evento_investimento [not null]
  valor          decimal(10,2)          [not null]
  data           date                   [not null]
  descricao      text
  created_at     timestamptz            [not null, default: `now()`]
  updated_at     timestamptz            [not null, default: `now()`]
  deleted_at     timestamptz

  indexes {
    (investimento_id, data) [name: 'idx_inv_eventos_investimento_data']
    (usuario_id, data)      [name: 'idx_inv_eventos_usuario_data']
  }

  Note: 'Histórico de eventos do investimento. Soft-delete.'
}

//
// ─── DOMAIN: METAS ────────────────────────────────────────────────────────────
//

Table metas {
  id          uuid         [pk, default: `gen_random_uuid()`]
  usuario_id  uuid         [not null, ref: > usuarios.id]
  nome        varchar(255) [not null]
  tipo        tipo_meta    [not null, default: 'economia']
  valor_alvo  decimal(10,2) [not null]
  data_inicio date         [not null]
  data_fim    date
  status      status_meta  [not null, default: 'ativa']
  icone       varchar(50)
  cor         varchar(7)
  observacoes text
  created_at  timestamptz  [not null, default: `now()`]
  updated_at  timestamptz  [not null, default: `now()`]
  deleted_at  timestamptz

  indexes {
    (usuario_id, status) [name: 'idx_metas_usuario_status']
  }

  Note: 'valor_atual = SUM(metas_movimentos.valor). Soft-delete.'
}

Table metas_movimentos {
  id              uuid        [pk, default: `gen_random_uuid()`]
  meta_id         uuid        [not null, ref: > metas.id]
  usuario_id      uuid        [not null, ref: > usuarios.id]
  valor           decimal(10,2) [not null]
  data            date        [not null]
  descricao       text
  movimentacao_id uuid        [ref: > movimentacoes_caixa.id]
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]
  deleted_at      timestamptz

  indexes {
    (meta_id, data) [name: 'idx_metas_mov_meta_data']
  }

  Note: 'Aporte ou resgate em uma meta. Pode vincular a movimentação real. Soft-delete.'
}

//
// ─── DOMAIN: ANEXOS ───────────────────────────────────────────────────────────
//

Table anexos {
  id             uuid        [pk, default: `gen_random_uuid()`]
  usuario_id     uuid        [not null, ref: > usuarios.id]
  nome_original  varchar(255) [not null]
  nome_arquivo   varchar(255) [not null]
  mime_type      varchar(100) [not null]
  tamanho_bytes  bigint      [not null]
  url            text        [not null]
  hash_sha256    varchar(64)
  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]
  deleted_at     timestamptz

  indexes {
    (usuario_id, hash_sha256) [name: 'idx_anexos_usuario_hash']
  }

  Note: 'hash_sha256 para deduplicação por usuário. Soft-delete.'
}

Table anexos_vinculos {
  id           uuid        [pk, default: `gen_random_uuid()`]
  anexo_id     uuid        [not null, ref: > anexos.id]
  entidade_tipo varchar(50) [not null]
  entidade_id  uuid        [not null]
  created_at   timestamptz [not null, default: `now()`]

  indexes {
    (entidade_tipo, entidade_id) [name: 'idx_anexos_vinculos_entidade']
  }

  Note: 'Polimórfico: entidade_tipo = contas_pagar | contas_receber | investimentos | metas. Sem soft-delete.'
}

//
// ─── DOMAIN: WHATSAPP ─────────────────────────────────────────────────────────
//

Table whatsapp_logs {
  id                 bigserial   [pk]
  usuario_id         uuid        [ref: > usuarios.id]
  provider           varchar(50) [not null]
  telefone           varchar(20) [not null]
  direcao            varchar(10) [not null]
  tipo_mensagem      varchar(50) [not null]
  conteudo           text
  status             varchar(50)
  provider_message_id varchar(255)
  created_at         timestamptz [not null, default: `now()`]
  updated_at         timestamptz [not null, default: `now()`]

  indexes {
    (usuario_id, created_at) [name: 'idx_wa_logs_usuario_data']
  }

  Note: 'BIGSERIAL — alto volume. Hard-delete. Sem deleted_at.'
}

//
// ─── DOMAIN: SISTEMA ──────────────────────────────────────────────────────────
//

Table jobs {
  id             bigserial   [pk]
  tipo           varchar(100) [not null]
  payload        jsonb
  status         varchar(50) [not null, default: 'pendente']
  tentativas     integer     [not null, default: 0]
  max_tentativas integer     [not null, default: 3]
  erro           text
  agendado_para  timestamptz
  iniciado_em    timestamptz
  concluido_em   timestamptz
  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]

  indexes {
    (status, agendado_para) [name: 'idx_jobs_status_agendado']
  }

  Note: 'BIGSERIAL — alta rotatividade. Hard-delete. status: pendente | processando | concluido | falhou.'
}
