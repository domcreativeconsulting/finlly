# ==============================================================================
# ETL Configuration — MySQL → Postgres Migration
# Copy this file to .env (or .env.local) and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# MySQL Legacy Database (Finlly Go)
# ------------------------------------------------------------------------------
LEGACY_MYSQL_HOST=localhost
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=finlly_go
LEGACY_MYSQL_PASSWORD=your_password_here
LEGACY_MYSQL_DATABASE=finlly_go

# ------------------------------------------------------------------------------
# Postgres New Database
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/finlly

# ------------------------------------------------------------------------------
# Timezone (Brazil / América do Sul)
# ------------------------------------------------------------------------------
# IMPORTANT: This MUST be set to match the timezone of the MySQL legacy database.
# All MySQL DATETIME fields are assumed to be in this timezone (no TZ info stored).
# The ETL will convert them to UTC (TIMESTAMPTZ) for Postgres storage.
#
# Brazil standard time since 2019 (DST was permanently abolished):
#   UTC-3 → America/Sao_Paulo (BRT — Brasília Standard Time)
#
# Do NOT change this unless your MySQL data is stored in a different timezone.
TZ=America/Sao_Paulo

# ------------------------------------------------------------------------------
# ETL Configuration
# ------------------------------------------------------------------------------

# Batch size for bulk inserts (1000–10000 recommended)
# - Small dataset (<10K rows):    1000
# - Medium dataset (10K–100K):    5000  ← default
# - Large dataset (>100K rows):  10000
ETL_BATCH_SIZE=5000

# Set to "true" to enable dry-run mode via environment variable
# (alternative to the --dry-run CLI flag)
ETL_DRY_RUN=false

# Set to "false" to disable sample validation (speeds up migration slightly)
ETL_VALIDATE_SAMPLES=true

# Transaction timeout in milliseconds (default: 120 000 = 2 minutes)
ETL_TRANSACTION_TIMEOUT_MS=120000

# Enable verbose debug logging
ETL_DEBUG=false
