# .env.example
# ========================================
# FINLLY - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ========================================

# ========================================
# API - Obrigatórias
# ========================================
NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:5173

# ========================================
# Database - Obrigatória
# ========================================
DATABASE_URL=postgresql://user:password@localhost:5432/finlly

# ========================================
# Redis - Obrigatória
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# Auth - JWT (Obrigatórias)
# ========================================
JWT_SECRET=change_me_with_a_secure_random_string_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_with_a_secure_random_string_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ========================================
# Billing - Asaas (Opcional)
# ========================================
ASAAS_ENV=sandbox
ASAAS_API_KEY=change_me
ASAAS_WEBHOOK_SECRET=change_me
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# ========================================
# WhatsApp Agent (Opcional - Futuro)
# ========================================
WA_PROVIDER=evolution
WA_BASE_URL=http://localhost:8080
WA_TOKEN=change_me
WA_PHONE_NUMBER_ID=123456789

# ========================================
# Evolution API — WhatsApp (Story 12.1)
# ========================================
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change_me
EVOLUTION_INSTANCE=finlly
EVOLUTION_TIMEOUT_MS=8000
EVOLUTION_MAX_RETRIES=2

# ========================================
# Rate Limiting (Opcional)
# ========================================
RATE_LIMIT_STORE=memory
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000

# ========================================
# Email (Opcional — e-mails são ignorados se não configurado)
# ========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-app
MAIL_FROM=noreply@finlly.com

# ========================================
# Tokens de Segurança (Opcional — usa valores padrão)
# ========================================
PASSWORD_RESET_EXPIRATION=900
EMAIL_VERIFICATION_EXPIRATION=86400

# ========================================
# Rate Limiting — Recuperação de Senha (Opcional)
# ========================================
FORGOT_PASSWORD_RATE_LIMIT=3
FORGOT_PASSWORD_RATE_WINDOW=3600
VERIFY_EMAIL_RATE_LIMIT=3
VERIFY_EMAIL_RATE_WINDOW=3600

# ========================================
# ETL — Migração MySQL → Postgres (Opcional)
# ========================================
LEGACY_MYSQL_HOST=localhost
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=finlly_go
LEGACY_MYSQL_PASSWORD=change_me
LEGACY_MYSQL_DATABASE=finlly_go

ETL_BATCH_SIZE=1000
ETL_DRY_RUN=false
ETL_VALIDATE_SAMPLES=true
# ========================================
# OCR/IA — Processamento de Anexos
# ========================================
OCR_PROVIDER=mock                    # mock | google_vision | aws_textract
OCR_JOB_INTERVAL_MS=5000             # Intervalo do worker OCR em ms
MAX_UPLOAD_SIZE_MB=10                # Tamanho máximo de upload em MB
UPLOAD_DIR=uploads                   # Diretório base de uploads

# Google Vision (quando OCR_PROVIDER=google_vision)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# AWS Textract (quando OCR_PROVIDER=aws_textract)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
