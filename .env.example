# .env.example
# ========================================
# FINLLY - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ========================================

# ========================================
# API - Obrigatórias
# ========================================
NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:5173

# ========================================
# Database - Obrigatória
# ========================================
DATABASE_URL=postgresql://user:password@localhost:5432/finlly

# ========================================
# Redis - Obrigatória
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# Auth - JWT (Obrigatórias)
# ========================================
JWT_SECRET=change_me_with_a_secure_random_string_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_with_a_secure_random_string_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ========================================
# Billing - Asaas (Opcional)
# ========================================
ASAAS_ENV=sandbox
ASAAS_API_KEY=change_me
ASAAS_WEBHOOK_SECRET=change_me
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# ========================================
# WhatsApp Agent (Opcional - Futuro)
# ========================================
WA_PROVIDER=evolution
WA_BASE_URL=http://localhost:8080
WA_TOKEN=change_me
WA_PHONE_NUMBER_ID=123456789

# ========================================
# Rate Limiting (Opcional)
# ========================================
RATE_LIMIT_STORE=memory
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000

# ========================================
# ETL — Migração MySQL → Postgres (Opcional)
# ========================================
LEGACY_MYSQL_HOST=localhost
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=finlly_go
LEGACY_MYSQL_PASSWORD=change_me
LEGACY_MYSQL_DATABASE=finlly_go

ETL_BATCH_SIZE=1000
ETL_DRY_RUN=false
ETL_VALIDATE_SAMPLES=true