# apps/api/.env.example
# ========================================
# API Server Configuration
# ========================================

# ========================================
# API - Obrigatórias
# ========================================
NODE_ENV=development
API_PORT=3001
APP_URL=http://localhost:5173

# ========================================
# Database - Obrigatória
# ========================================
DATABASE_URL=postgresql://user:password@localhost:5432/finlly

# ========================================
# Redis - Obrigatória
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# Auth - JWT (Obrigatórias)
# ========================================
JWT_SECRET=change_me_with_a_secure_random_string_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_with_a_secure_random_string_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ========================================
# Billing - Asaas (Opcional)
# ========================================
ASAAS_ENV=sandbox
ASAAS_API_KEY=change_me
ASAAS_WEBHOOK_SECRET=change_me
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# ========================================
# WhatsApp Agent (Opcional - Futuro)
# ========================================
WA_PROVIDER=evolution
WA_BASE_URL=http://localhost:8080
WA_TOKEN=change_me
WA_PHONE_NUMBER_ID=123456789

# ========================================
# Rate Limiting (Opcional)
# ========================================
RATE_LIMIT_STORE=memory
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000

# ========================================
# CORS (Opcional — separe múltiplas origens por vírgula)
# ========================================
# CORS_ORIGINS=https://app.finlly.com.br,https://finlly.com.br
# ========================================
# EPIC 11 — Anexos & OCR
# ========================================
UPLOADS_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
OCR_PROVIDER=mock
OCR_JOB_INTERVAL_MS=5000

# ========================================
# Storage — Driver configurável
# ========================================
STORAGE_DRIVER=local

# S3 / S3-compatible (obrigatório se STORAGE_DRIVER=s3)
# S3_BUCKET=finlly-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=change_me
# S3_SECRET_ACCESS_KEY=change_me
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_PUBLIC_BASE_URL=https://finlly-uploads.s3.amazonaws.com
