{
  "name": "finlly",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "cd apps/api && npm run build && cd ../web && npm run build",
    "test": "npm run test --workspace=apps/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "test -n \"$CI\" || husky",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "etl:test": "ts-node --esm --project tsconfig.prisma.json scripts/etl/test-connection.ts",
    "etl:dry-run": "cross-env ETL_DRY_RUN=true tsx scripts/etl/etl.ts",
    "etl:execute": "ETL_DRY_RUN=false ts-node --esm --project tsconfig.prisma.json scripts/etl/etl.ts",
    "etl:rollback": "ts-node --esm --project tsconfig.prisma.json scripts/etl/rollback.ts"
  },
  "prisma": {
    "seed": "ts-node --esm --project tsconfig.prisma.json prisma/seed.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "husky": "^9.1.7",
    "prisma": "^7.4.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "lint-staged": "^15.2.7",
    "mysql2": "^3.18.2",
    "pg": "^8.19.0",
    "prettier": "^3.3.3",
    "uuid": "^13.0.0"
  }
}
